# Only for server-side Google Business Profile access authorized by the owner.
# Copy to .env.local and fill locally; never commit secrets or paste them in chat.
# Google API approval and the owner's OAuth consent are required.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Resource name from the authorized Google Business Profile account, not Maps CID.
GOOGLE_BUSINESS_LOCATION=

# Supabase local development settings.
SUPABASE_URL=https://lykeruumioxbmcvryrnq.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# The same random token must be stored as a SHA-256 hash in Supabase
# using the instructions in SUPABASE_SETUP.md. Never use this in the browser.
SUPABASE_INTAKE_TOKEN=
